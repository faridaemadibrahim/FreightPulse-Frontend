# Base REST URL used by server components. In the browser the app calls the
# relative /api/v1 and lets the next.config.ts rewrite proxy it.
API_URL=http://localhost:8000/api/v1

# Alerts WebSocket endpoint.
WS_URL=ws://localhost:8000/api/v1/ws/alerts

# Sent as the X-API-Key header on every request.
API_KEY=dev-api-key

# Must be the UUID that owns the API key above — the backend rejects a
# non-UUID user id with a 403 during WebSocket auth.
USER_ID=

# Set to true to serve the fixtures in mocks/ instead of calling the backend.
NEXT_PUBLIC_USE_MOCKS=false

# Proxy target for the /api/v1/* rewrite.
INTERNAL_BACKEND_URL=http://localhost:8000
